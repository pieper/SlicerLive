   "property": "segmentation.fill2D.opacity",
   "node": "$seg",
   "path": "#/fill2D/opacity",
   "slicerGet": "nd.GetDisplayNode().GetOpacity2DFill()",
   "slicerSet": "nd.GetDisplayNode().SetOpacity2DFill(%V%)",
   "inV": 0.35,
   "outV": 0.65,
