   ],
   "outV": [
    0,
    0,
    1
   ],
   "tol": 0.02
  },
  {
   "id": "camera.viewAngle",
   "property": "camera.viewAngle",
   "node": "$camera",
   "path": "#/viewAngle",
   "slicerGet": "nd.GetCamera().GetViewAngle()",
   "slicerSet": "nd.GetCamera().SetViewAngle(%V%); nd.Modified()",
