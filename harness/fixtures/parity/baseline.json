{
 "name": "baseline",
 "description": "The 20 MRML<->mrson properties from render/test/parity-run.ts (S0-S10). Both directions per row. Node aliases ($svd $vr $seg $fid $camera $layout $tf) resolve to the FIRST node of that class in the running Slicer (see harness/parity/baseline.parity.test.ts); build the scene with harness/parity/setup.ts.",
 "rows": [
  {
   "id": "svd.window",
   "property": "scalarVolumeDisplay.window",
   "node": "$svd",
   "path": "#/window",
   "slicerGet": "nd.GetWindow()",
   "slicerSet": "nd.SetAutoWindowLevel(0); nd.SetWindow(%V%)",
   "inV": 210,
   "outV": 175,
   "tol": 0.5,
   "ref": "vtkMRMLScalarVolumeDisplayNode"
  },
  {
   "id": "svd.interpolate",
   "property": "scalarVolumeDisplay.interpolate",
   "node": "$svd",
   "path": "#/interpolate",
   "slicerGet": "nd.GetInterpolate()",
   "slicerSet": "nd.SetInterpolate(%V%)",
   "inV": false,
   "outV": true,
   "bool": true
  },
  {
   "id": "vr.visible",
