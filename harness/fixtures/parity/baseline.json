  {
   "id": "slice.fieldOfView",
   "property": "slice.fieldOfView",
   "node": "vtkMRMLSliceNodeRed",
   "path": "#/fieldOfView",
   "slicerGet": "list(nd.GetFieldOfView())",
   "slicerSet": "nd.SetFieldOfView(%V%); nd.UpdateMatrices()",
   "inV": [
    250,
    180,
    1
   ],
   "outV": [
    300,
    200,
    1
   ],
   "tol": 0.5,
   "unit": "mm"
  },
  {
   "id": "tf.scalarOpacity3",
   "property": "transferFunction.scalarOpacity[3].opacity",
   "node": "$tf",
   "path": "#/scalarOpacity/3/opacity",
   "slicerGet": "(lambda v=[0.0,0.0,0.0,0.0]: (nd.GetVolumeProperty().GetScalarOpacity(0).GetNodeValue(3,v), v[1])[1])()",
   "slicerSet": "so=nd.GetVolumeProperty().GetScalarOpacity(0); v=[0.0,0.0,0.0,0.0]; so.GetNodeValue(3,v); v[1]=%V%; so.SetNodeValue(3,v); nd.Modified()",
   "inV": 0.62,
   "outV": 0.44,
   "tol": 0.01
  },
  {
   "id": "tf.colorStop3",
   "property": "transferFunction.colorStops[3].rgba",
   "node": "$tf",
   "path": "#/colorStops/3/rgba",
   "slicerGet": "(lambda v=[0.0]*6: (nd.GetVolumeProperty().GetRGBTransferFunction(0).GetNodeValue(3,v), [v[1],v[2],v[3]])[1])()",
   "slicerSet": "f=nd.GetVolumeProperty().GetRGBTransferFunction(0); v=[0.0]*6; f.GetNodeValue(3,v); _c=[%V%]; v[1],v[2],v[3]=_c[0],_c[1],_c[2]; f.SetNodeValue(3,v); nd.Modified()",
   "inV": [
    0.2,
    0.5,
    0.9
   ],
   "outV": [
    0.9,
    0.4,
    0.1
   ],
   "tol": 0.02
  },
  {
   "id": "layout.arrangement",
   "property": "layout.arrangement",
   "node": "$layout",
   "path": "#/arrangement",
   "slicerGet": "nd.GetViewArrangement()",
   "slicerSet": "nd.SetViewArrangement(%V%)",
   "inV": 6,
   "outV": 3,
   "tol": 0.1,
   "ref": "vtkMRMLLayoutNode::SlicerLayout (ends on FourUp=3)"
  }
 ]
}