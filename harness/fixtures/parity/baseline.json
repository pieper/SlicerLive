   "outV": 80,
   "tol": 0.5
  },
  {
   "id": "slice.offset",
   "property": "slice.offset",
   "node": "vtkMRMLSliceNodeRed",
   "path": "#/offset",
   "slicerGet": "nd.GetSliceOffset()",
   "slicerSet": "nd.SetSliceOffset(%V%)",
   "inV": 12.0,
