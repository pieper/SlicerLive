   "property": "markup.textScale",
   "node": "$fid",
   "path": "#/textScale",
   "slicerGet": "nd.GetDisplayNode().GetTextScale()",
   "slicerSet": "nd.GetDisplayNode().SetTextScale(%V%)",
   "inV": 4.0,
   "outV": 2.0,
   "tol": 0.05
